{
  "mcpServers": {
    "UnityMCP": {
      "command": "/Users/economy/.local/bin/uvx",
      "args": [
        "--with",
        "mcp>=1.24,<2",
        "--from",
        "mcpforunityserver==9.3.1",
        "mcp-for-unity",
        "--transport",
        "stdio"
      ],
      "env": {
        "UNITY_MCP_DISABLE_TELEMETRY": "true"
      }
    }
  }
}
