    <ui:VisualElement name="TutorialOverlay" picking-mode="Position" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: none; justify-content: center; align-items: center; background-color: rgba(4, 9, 15, 0.82);">
