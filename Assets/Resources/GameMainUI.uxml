<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="TopBar" style="flex-direction: row; align-items: center; justify-content: space-between; width: 100%; height: auto; min-height: 130px; background-color: rgba(0, 0, 0, 0.5); padding-left: 80px; padding-right: 80px; padding-top: 130px; padding-bottom: 32px;">

        <!-- 좌측: STAGE / 스테이지 번호 (세로 정렬) -->
        <!-- STAGE / 번호를 가운데 정렬 -->
        <ui:VisualElement name="StageContainer" style="flex-direction: column; align-items: center; padding-left: 8px; padding-right: 24px;">
            <ui:Label name="StageTitle" text="STAGE" style="-unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Examples%20&amp;%20Extras/Fonts/Oswald-Bold.ttf?fileID=12800000&amp;guid=c9f6d0e7bc8541498c9a4799ba184ede&amp;type=3#Oswald-Bold&quot;); font-size: 44px; color: rgb(255, 255, 255); -unity-font-style: bold; letter-spacing: 1px;"/>
            <ui:Label name="StageNumber" text="01" style="-unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Examples%20&amp;%20Extras/Fonts/Oswald-Bold.ttf?fileID=12800000&amp;guid=c9f6d0e7bc8541498c9a4799ba184ede&amp;type=3#Oswald-Bold&quot;); font-size: 36px; color: rgb(255, 255, 255); -unity-font-style: bold; margin-top: 8px;"/>
        </ui:VisualElement>

        <!-- 중앙: 진행도 ProgressBar (맵 전체 카운트 기반, 중앙 정렬) -->
        <ui:VisualElement name="CenterContainer" style="flex-grow: 1; flex-direction: row; justify-content: center; padding-left: 60px; padding-right: 60px;">
            <ui:ProgressBar name="GameProgress" value="0" title="" style="width: 460px; height: 44px; color: rgb(255, 255, 255); font-size: 22px;"/>
        </ui:VisualElement>

        <!-- 우측: 설정 버튼 (동그란 테두리, 배경 없음) -->
        <ui:Button name="SettingButton" text="" style="width: 120px; height: 120px; background-color: rgba(0, 0, 0, 0); border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-radius: 999px; justify-content: center; align-items: center; padding-left: 8px; padding-right: 8px; padding-top: 8px; padding-bottom: 8px;">
            <ui:Image name="SettingIcon" style="width: 88px; height: 88px;"/>
        </ui:Button>

    </ui:VisualElement>

    <!-- 하단: 스킵 / 리셋 / 광고제거 버튼 바 -->
    <ui:VisualElement name="BottomBar" style="position: absolute; bottom: 80px; left: 0px; right: 0px; flex-direction: row; justify-content: space-around; align-items: center; padding-left: 80px; padding-right: 80px;">

        <!-- 왼쪽: 스킵 버튼 -->
        <ui:Button name="SkipButton" text="" style="width: 120px; height: 120px; background-color: rgba(0, 0, 0, 0); border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-radius: 999px; justify-content: center; align-items: center; padding-left: 8px; padding-right: 8px; padding-top: 8px; padding-bottom: 8px;">
            <ui:Image name="SkipIcon" style="width: 88px; height: 88px;"/>
        </ui:Button>

        <!-- 중앙: 리셋 버튼 -->
        <ui:Button name="ResetButton" text="" style="width: 120px; height: 120px; background-color: rgba(0, 0, 0, 0); border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-radius: 999px; justify-content: center; align-items: center; padding-left: 8px; padding-right: 8px; padding-top: 8px; padding-bottom: 8px;">
            <ui:Image name="ResetIcon" style="width: 88px; height: 88px;"/>
        </ui:Button>

        <!-- 오른쪽: 광고 제거 버튼 -->
        <ui:Button name="BlockAdsButton" text="" style="width: 120px; height: 120px; background-color: rgba(0, 0, 0, 0); border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-radius: 999px; justify-content: center; align-items: center; padding-left: 8px; padding-right: 8px; padding-top: 8px; padding-bottom: 8px;">
            <ui:Image name="BlockIcon" style="width: 88px; height: 88px;"/>
        </ui:Button>

    </ui:VisualElement>
</ui:UXML>