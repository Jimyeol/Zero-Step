<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="TopBar" class="top-hud">
        <ui:VisualElement name="TopHudBackdrop" class="top-hud-backdrop" picking-mode="Ignore">
            <ui:VisualElement class="top-hud-circuit-line top-hud-circuit-line-a"/>
            <ui:VisualElement class="top-hud-circuit-line top-hud-circuit-line-b"/>
            <ui:VisualElement class="top-hud-circuit-line top-hud-circuit-line-c"/>
            <ui:VisualElement class="top-hud-circuit-dot top-hud-circuit-dot-a"/>
            <ui:VisualElement class="top-hud-circuit-dot top-hud-circuit-dot-b"/>
            <ui:VisualElement class="top-hud-circuit-dot top-hud-circuit-dot-c"/>
            <ui:VisualElement class="top-hud-corner top-hud-corner-left"/>
            <ui:VisualElement class="top-hud-corner top-hud-corner-right"/>
        </ui:VisualElement>
        <ui:VisualElement name="StageContainer" class="top-stage-panel">
            <ui:VisualElement class="top-stage-panel-glow" picking-mode="Ignore"/>
            <ui:Label name="StageTitle" text="STAGE" class="top-stage-title"/>
            <ui:Label name="StageNumber" text="01" class="top-stage-number"/>
        </ui:VisualElement>
        <ui:VisualElement name="CenterContainer" class="top-center-panel">
            <ui:VisualElement name="TopProgressFrame" class="top-progress-frame">
                <ui:VisualElement class="top-progress-glow" picking-mode="Ignore"/>
                <ui:ProgressBar name="GameProgress" value="0" title="" class="top-progress-bar"/>
                <ui:VisualElement class="top-progress-segment top-progress-segment-a" picking-mode="Ignore"/>
                <ui:VisualElement class="top-progress-segment top-progress-segment-b" picking-mode="Ignore"/>
                <ui:VisualElement class="top-progress-segment top-progress-segment-c" picking-mode="Ignore"/>
                <ui:VisualElement class="top-progress-segment top-progress-segment-d" picking-mode="Ignore"/>
            </ui:VisualElement>
            <ui:VisualElement name="HeartContainer" class="top-heart-row">
                <ui:VisualElement class="top-heart-glow top-heart-glow-a" picking-mode="Ignore"/>
                <ui:VisualElement class="top-heart-glow top-heart-glow-b" picking-mode="Ignore"/>
                <ui:VisualElement class="top-heart-glow top-heart-glow-c" picking-mode="Ignore"/>
                <ui:Image name="Heart1Image" class="heart-icon top-heart-icon"/>
                <ui:Image name="Heart2Image" class="heart-icon top-heart-icon"/>
                <ui:Image name="Heart3Image" class="heart-icon top-heart-icon"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button name="SettingButton" text="" class="top-setting-button">
            <ui:VisualElement class="top-setting-glow" picking-mode="Ignore"/>
            <ui:VisualElement class="top-setting-ring" picking-mode="Ignore"/>
            <ui:VisualElement class="top-setting-frame" picking-mode="Ignore"/>
            <ui:VisualElement class="top-setting-disc" picking-mode="Ignore"/>
            <ui:VisualElement class="top-setting-icon-slot" picking-mode="Ignore">
                <ui:Image name="SettingIcon" class="top-setting-icon"/>
            </ui:VisualElement>
        </ui:Button>
    </ui:VisualElement>
    <ui:VisualElement name="BottomBar" class="bottom-bar-neon">
        <ui:VisualElement name="BottomBarCircuitBackdrop" class="bottom-bar-circuit-backdrop" picking-mode="Ignore">
            <ui:VisualElement class="bottom-circuit-line bottom-circuit-line-a"/>
            <ui:VisualElement class="bottom-circuit-line bottom-circuit-line-b"/>
            <ui:VisualElement class="bottom-circuit-line bottom-circuit-line-c"/>
            <ui:VisualElement class="bottom-circuit-dot bottom-circuit-dot-a"/>
            <ui:VisualElement class="bottom-circuit-dot bottom-circuit-dot-b"/>
            <ui:VisualElement class="bottom-circuit-dot bottom-circuit-dot-c"/>
        </ui:VisualElement>
        <ui:Button name="HintButton" text="" class="neon-action-button neon-action-button-hint">
            <ui:VisualElement class="neon-button-glow" picking-mode="Ignore"/>
            <ui:VisualElement class="neon-button-ring neon-button-ring-outer" picking-mode="Ignore"/>
            <ui:VisualElement class="neon-button-ring neon-button-ring-bright" picking-mode="Ignore"/>
            <ui:VisualElement class="neon-button-arc neon-button-arc-a" picking-mode="Ignore"/>
            <ui:VisualElement class="neon-button-arc neon-button-arc-b" picking-mode="Ignore"/>
            <ui:VisualElement class="neon-button-disc" picking-mode="Ignore"/>
            <ui:VisualElement class="neon-button-icon-slot" picking-mode="Ignore">
                <ui:Image name="HintIcon" class="neon-button-icon"/>
            </ui:VisualElement>
            <ui:VisualElement name="HintBadge" class="neon-ad-badge" picking-mode="Ignore">
                <ui:Label name="HintBadgeText" text="x3" class="neon-ad-badge-text"/>
            </ui:VisualElement>
        </ui:Button>
        <ui:Button name="ResetButton" text="" class="neon-action-button neon-action-button-reset">
            <ui:VisualElement class="neon-button-glow" picking-mode="Ignore"/>
            <ui:VisualElement class="neon-button-ring neon-button-ring-outer" picking-mode="Ignore"/>
            <ui:VisualElement class="neon-button-ring neon-button-ring-bright" picking-mode="Ignore"/>
            <ui:VisualElement class="neon-button-arc neon-button-arc-a" picking-mode="Ignore"/>
            <ui:VisualElement class="neon-button-arc neon-button-arc-b" picking-mode="Ignore"/>
            <ui:VisualElement class="neon-button-disc" picking-mode="Ignore"/>
            <ui:VisualElement class="neon-button-icon-slot" picking-mode="Ignore">
                <ui:Image name="ResetIcon" class="neon-button-icon"/>
            </ui:VisualElement>
        </ui:Button>
        <ui:Button name="SkipButton" text="" class="neon-action-button neon-action-button-skip">
            <ui:VisualElement class="neon-button-glow" picking-mode="Ignore"/>
            <ui:VisualElement class="neon-button-ring neon-button-ring-outer" picking-mode="Ignore"/>
            <ui:VisualElement class="neon-button-ring neon-button-ring-bright" picking-mode="Ignore"/>
            <ui:VisualElement class="neon-button-arc neon-button-arc-a" picking-mode="Ignore"/>
            <ui:VisualElement class="neon-button-arc neon-button-arc-b" picking-mode="Ignore"/>
            <ui:VisualElement class="neon-button-disc" picking-mode="Ignore"/>
            <ui:VisualElement class="neon-button-icon-slot" picking-mode="Ignore">
                <ui:Image name="SkipIcon" class="neon-button-icon"/>
            </ui:VisualElement>
            <ui:VisualElement name="SkipAdBadge" class="neon-ad-badge" picking-mode="Ignore">
                <ui:Label name="SkipAdBadgeText" text="x1" class="neon-ad-badge-text"/>
            </ui:VisualElement>
        </ui:Button>
        <ui:Button name="BlockAdsButton" text="" class="neon-action-button neon-action-button-block">
            <ui:VisualElement class="neon-button-glow" picking-mode="Ignore"/>
            <ui:VisualElement class="neon-button-ring neon-button-ring-outer" picking-mode="Ignore"/>
            <ui:VisualElement class="neon-button-ring neon-button-ring-bright" picking-mode="Ignore"/>
            <ui:VisualElement class="neon-button-arc neon-button-arc-a" picking-mode="Ignore"/>
            <ui:VisualElement class="neon-button-arc neon-button-arc-b" picking-mode="Ignore"/>
            <ui:VisualElement class="neon-button-disc" picking-mode="Ignore"/>
            <ui:VisualElement class="neon-button-icon-slot" picking-mode="Ignore">
                <ui:Image name="BlockIcon" class="neon-button-icon"/>
            </ui:VisualElement>
        </ui:Button>
    </ui:VisualElement>
    <ui:VisualElement name="StageSnackbar" picking-mode="Ignore" style="position: absolute; left: 5%; right: 5%; bottom: 300px; min-height: 92px; padding-left: 30px; padding-right: 30px; padding-top: 20px; padding-bottom: 20px; border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px; border-left-color: rgba(168, 234, 255, 0.94); border-right-color: rgba(168, 234, 255, 0.94); border-top-color: rgba(168, 234, 255, 0.94); border-bottom-color: rgba(168, 234, 255, 0.94); border-radius: 22px; background-color: rgba(6, 17, 28, 0.92); justify-content: center; align-items: center; display: none;">
        <ui:Label name="StageSnackbarLabel" text="" style="font-size: 31px; color: rgba(223, 246, 255, 1); -unity-text-align: middle-center; -unity-font-style: bold; white-space: normal;"/>
    </ui:VisualElement>
    <ui:VisualElement name="HintLoadingOverlay" picking-mode="Ignore" class="hint-loading-overlay" style="display: none;">
        <ui:VisualElement class="hint-loading-panel">
            <ui:Label name="HintLoadingLabel" text="힌트 찾는 중..." class="hint-loading-label"/>
            <ui:ProgressBar name="HintLoadingProgress" value="0" title="" class="hint-loading-progress"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="BannerAdContainer" style="position: absolute; bottom: 0; left: 0; right: 0; height: 80px; background-color: rgba(0, 0, 0, 0.3); justify-content: center; align-items: center;">
        <ui:Label name="BannerAdPlaceholder" text="Banner" style="font-size: 14px; color: rgba(255, 255, 255, 0.5); -unity-text-align: middle-center;"/>
    </ui:VisualElement>
    <ui:VisualElement name="SettingPopupOverlay" picking-mode="Position" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: none; justify-content: center; align-items: center; background-color: rgba(0, 0, 0, 0.65);">
        <ui:VisualElement name="SettingPopupPanel" style="width: 980px; max-width: 98%; height: 80%; background-color: rgba(8, 10, 16, 0.96); border-left-width: 4px; border-right-width: 4px; border-top-width: 4px; border-bottom-width: 4px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-radius: 32px; padding-left: 34px; padding-right: 34px; padding-top: 30px; padding-bottom: 30px;">
            <ui:VisualElement name="SettingHeader" style="height: 132px; flex-direction: row; justify-content: space-between; align-items: center; padding-left: 14px; padding-right: 14px;">
                <ui:Label name="SettingTitleLabel" text="설정" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Orbitron-Medium.ttf?fileID=12800000&amp;guid=d788a3059e71747c680a1ce1e963cd99&amp;type=3#Orbitron-Medium&quot;); font-size: 56px; color: rgb(255, 255, 255); -unity-font-style: bold; letter-spacing: 1px;"/>
                <ui:Button name="SettingCloseButton" text="" style="width: 108px; height: 108px; color: rgb(255, 255, 255); background-color: rgba(0, 0, 0, 0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; border-radius: 0; justify-content: center; align-items: center; padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px;">
                    <ui:Image name="SettingCloseIcon" style="width: 64px; height: 64px;"/>
                </ui:Button>
            </ui:VisualElement>

            <ui:ScrollView name="SettingScrollView" style="flex-grow: 1; margin-top: 12px;">
                <ui:Label name="GameSettingSectionLabel" text="게임 설정" style="font-size: 36px; color: rgba(143, 235, 255, 1); -unity-font-style: bold; margin-top: 16px; margin-left: 8px; margin-bottom: 18px;"/>

                <ui:VisualElement name="SoundRow" style="height: 140px; flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 18px; padding-left: 30px; padding-right: 30px; border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px; border-left-color: rgba(255, 255, 255, 0.35); border-right-color: rgba(255, 255, 255, 0.35); border-top-color: rgba(255, 255, 255, 0.35); border-bottom-color: rgba(255, 255, 255, 0.35); border-radius: 20px; background-color: rgba(255, 255, 255, 0.03);">
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Image name="SoundIcon" class="settings-icon" style="margin-right: 20px;"/>
                        <ui:Label name="SoundRowLabel" text="소리" style="font-size: 44px; color: rgb(255, 255, 255);"/>
                    </ui:VisualElement>
                    <ui:Button name="SoundSwitchButton" class="settings-switch settings-switch-on" text="">
                        <ui:Label name="SoundSwitchLabel" text="ON" class="settings-switch-label"/>
                        <ui:VisualElement name="SoundSwitchKnob" class="settings-switch-knob"/>
                    </ui:Button>
                </ui:VisualElement>

                <ui:VisualElement name="VibrationRow" style="height: 140px; flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 30px; padding-left: 30px; padding-right: 30px; border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px; border-left-color: rgba(255, 255, 255, 0.35); border-right-color: rgba(255, 255, 255, 0.35); border-top-color: rgba(255, 255, 255, 0.35); border-bottom-color: rgba(255, 255, 255, 0.35); border-radius: 20px; background-color: rgba(255, 255, 255, 0.03);">
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Image name="VibrationIcon" class="settings-icon" style="margin-right: 20px;"/>
                        <ui:Label name="VibrationRowLabel" text="진동" style="font-size: 44px; color: rgb(255, 255, 255);"/>
                    </ui:VisualElement>
                    <ui:Button name="VibrationSwitchButton" class="settings-switch settings-switch-on" text="">
                        <ui:Label name="VibrationSwitchLabel" text="ON" class="settings-switch-label"/>
                        <ui:VisualElement name="VibrationSwitchKnob" class="settings-switch-knob"/>
                    </ui:Button>
                </ui:VisualElement>

                <ui:Label name="HelpLanguageSectionLabel" text="도움말 · 언어" style="font-size: 36px; color: rgba(143, 235, 255, 1); -unity-font-style: bold; margin-left: 8px; margin-bottom: 18px;"/>

                <ui:Button name="HelpButton" text="" style="height: 126px; margin-bottom: 18px; border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px; border-left-color: rgba(255, 255, 255, 0.35); border-right-color: rgba(255, 255, 255, 0.35); border-top-color: rgba(255, 255, 255, 0.35); border-bottom-color: rgba(255, 255, 255, 0.35); border-radius: 20px; background-color: rgba(255, 255, 255, 0.03); justify-content: center;">
                    <ui:VisualElement style="flex-direction: row; align-items: center; padding-left: 30px;">
                        <ui:Image name="HelpIcon" class="settings-icon" style="margin-right: 20px;"/>
                        <ui:Label name="HelpMenuLabel" text="도움말" style="font-size: 40px; color: rgb(255, 255, 255);"/>
                    </ui:VisualElement>
                </ui:Button>

                <ui:Button name="LanguageButton" text="" style="height: 126px; margin-bottom: 30px; border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px; border-left-color: rgba(255, 255, 255, 0.35); border-right-color: rgba(255, 255, 255, 0.35); border-top-color: rgba(255, 255, 255, 0.35); border-bottom-color: rgba(255, 255, 255, 0.35); border-radius: 20px; background-color: rgba(255, 255, 255, 0.03); justify-content: center;">
                    <ui:VisualElement style="flex-direction: row; align-items: center; padding-left: 30px;">
                        <ui:Image name="LanguageIcon" class="settings-icon" style="margin-right: 20px;"/>
                        <ui:Label name="LanguageMenuLabel" text="언어 변경" style="font-size: 40px; color: rgb(255, 255, 255);"/>
                    </ui:VisualElement>
                </ui:Button>

                <ui:Label name="RecommendServiceSectionLabel" text="추천 · 서비스" style="font-size: 36px; color: rgba(143, 235, 255, 1); -unity-font-style: bold; margin-left: 8px; margin-bottom: 18px;"/>
                <ui:Button name="RateButton" text="평가하기" style="height: 122px; margin-bottom: 18px; font-size: 40px; color: rgb(255, 255, 255); border-radius: 20px; background-color: rgba(255, 255, 255, 0.03); border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px; border-left-color: rgba(255, 255, 255, 0.35); border-right-color: rgba(255, 255, 255, 0.35); border-top-color: rgba(255, 255, 255, 0.35); border-bottom-color: rgba(255, 255, 255, 0.35);"/>
                <ui:Button name="RemoveAdsButton" text="광고 제거" style="height: 122px; margin-bottom: 18px; font-size: 40px; color: rgb(255, 255, 255); border-radius: 20px; background-color: rgba(255, 209, 102, 0.14); border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px; border-left-color: rgba(255, 255, 255, 0.45); border-right-color: rgba(255, 255, 255, 0.45); border-top-color: rgba(255, 255, 255, 0.45); border-bottom-color: rgba(255, 255, 255, 0.45);"/>
                <ui:Button name="EmailButton" text="개발자에게 이메일 보내기" style="height: 122px; margin-bottom: 30px; font-size: 40px; color: rgb(255, 255, 255); border-radius: 20px; background-color: rgba(255, 255, 255, 0.03); border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px; border-left-color: rgba(255, 255, 255, 0.35); border-right-color: rgba(255, 255, 255, 0.35); border-top-color: rgba(255, 255, 255, 0.35); border-bottom-color: rgba(255, 255, 255, 0.35);"/>

                <ui:Label name="DataPolicySectionLabel" text="데이터 · 정책" style="font-size: 36px; color: rgba(255, 181, 181, 1); -unity-font-style: bold; margin-left: 8px; margin-bottom: 18px;"/>
                <ui:Button name="ResetDataButton" text="데이터 초기화" style="height: 122px; margin-bottom: 18px; font-size: 40px; color: rgb(255, 255, 255); border-radius: 20px; background-color: rgba(255, 109, 109, 0.18); border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px; border-left-color: rgba(255, 140, 140, 0.7); border-right-color: rgba(255, 140, 140, 0.7); border-top-color: rgba(255, 140, 140, 0.7); border-bottom-color: rgba(255, 140, 140, 0.7);"/>
                <ui:Button name="PrivacyPolicyButton" text="개인정보처리방침" style="height: 118px; margin-bottom: 18px; font-size: 36px; color: rgba(234, 238, 255, 1); border-radius: 20px; background-color: rgba(255, 255, 255, 0.02); border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px; border-left-color: rgba(255, 255, 255, 0.28); border-right-color: rgba(255, 255, 255, 0.28); border-top-color: rgba(255, 255, 255, 0.28); border-bottom-color: rgba(255, 255, 255, 0.28);"/>
                <ui:Button name="TermsButton" text="이용약관" style="height: 118px; margin-bottom: 18px; font-size: 36px; color: rgba(234, 238, 255, 1); border-radius: 20px; background-color: rgba(255, 255, 255, 0.02); border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px; border-left-color: rgba(255, 255, 255, 0.28); border-right-color: rgba(255, 255, 255, 0.28); border-top-color: rgba(255, 255, 255, 0.28); border-bottom-color: rgba(255, 255, 255, 0.28);"/>
            </ui:ScrollView>
            <ui:VisualElement name="ResetConfirmOverlay" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: none; justify-content: center; align-items: center; background-color: rgba(0, 0, 0, 0.8); border-radius: 32px;">
                <ui:VisualElement name="ResetConfirmDialog" style="width: 90%; max-width: 860px; min-height: 460px; background-color: rgba(14, 17, 24, 0.98); border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px; border-left-color: rgba(255, 173, 173, 0.95); border-right-color: rgba(255, 173, 173, 0.95); border-top-color: rgba(255, 173, 173, 0.95); border-bottom-color: rgba(255, 173, 173, 0.95); border-radius: 24px; padding-left: 30px; padding-right: 30px; padding-top: 30px; padding-bottom: 30px;">
                    <ui:Label name="ResetConfirmTitle" text="경고" style="font-size: 54px; color: rgb(255, 255, 255); -unity-font-style: bold; margin-bottom: 20px; -unity-text-align: middle-center;"/>
                    <ui:Label name="ResetConfirmMessage" text="데이터들이 다 초기화됩니다. 정말 초기화하시겠습니까?" style="font-size: 40px; color: rgba(255, 232, 232, 1); -unity-text-align: middle-center; margin-bottom: 30px;"/>
                    <ui:VisualElement style="flex-direction: row; justify-content: center; align-items: center;">
                        <ui:Button name="ResetConfirmCancelButton" text="취소" style="width: 280px; height: 108px; margin-right: 18px; font-size: 40px; color: rgb(255, 255, 255); border-radius: 20px; background-color: rgba(255, 255, 255, 0.08); border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px; border-left-color: rgba(255, 255, 255, 0.6); border-right-color: rgba(255, 255, 255, 0.6); border-top-color: rgba(255, 255, 255, 0.6); border-bottom-color: rgba(255, 255, 255, 0.6);"/>
                        <ui:Button name="ResetConfirmOkButton" text="초기화" style="width: 280px; height: 108px; margin-left: 18px; font-size: 40px; color: rgb(255, 255, 255); border-radius: 20px; background-color: rgba(255, 109, 109, 0.26); border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px; border-left-color: rgba(255, 150, 150, 0.85); border-right-color: rgba(255, 150, 150, 0.85); border-top-color: rgba(255, 150, 150, 0.85); border-bottom-color: rgba(255, 150, 150, 0.85);"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="LanguageSelectOverlay" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: none; justify-content: center; align-items: center; background-color: rgba(2, 5, 10, 0.82); border-radius: 32px;">
                <ui:VisualElement name="LanguageSelectDialog" style="width: 92%; max-width: 860px; min-height: 560px; max-height: 88%; background-color: rgba(9, 14, 22, 0.98); border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px; border-left-color: rgba(178, 236, 255, 0.95); border-right-color: rgba(178, 236, 255, 0.95); border-top-color: rgba(178, 236, 255, 0.95); border-bottom-color: rgba(178, 236, 255, 0.95); border-radius: 24px; padding-left: 24px; padding-right: 24px; padding-top: 18px; padding-bottom: 18px;">
                    <ui:VisualElement style="height: 100px; flex-direction: row; justify-content: space-between; align-items: center; padding-left: 8px; padding-right: 8px;">
                        <ui:Label name="LanguageSelectTitleLabel" text="언어 선택" style="font-size: 46px; color: rgb(255, 255, 255); -unity-font-style: bold; letter-spacing: 0.6px;"/>
                        <ui:Button name="LanguageSelectCloseButton" text="" style="width: 96px; height: 96px; background-color: rgba(0, 0, 0, 0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; border-radius: 0; justify-content: center; align-items: center;">
                            <ui:Image name="LanguageSelectCloseIcon" style="width: 60px; height: 60px;"/>
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:ScrollView name="LanguageSelectScrollView" style="flex-grow: 1; margin-top: 6px;">
                        <ui:VisualElement name="LanguageOptionList" style="flex-direction: column;"/>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="HeartDepletedOverlay" picking-mode="Position" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: none; justify-content: center; align-items: center; background-color: rgba(4, 7, 12, 0.78);">
        <ui:VisualElement name="HeartDepletedDialog" style="width: 92%; max-width: 940px; min-height: 460px; background-color: rgba(7, 11, 18, 0.98); border-left-width: 4px; border-right-width: 4px; border-top-width: 4px; border-bottom-width: 4px; border-left-color: rgba(156, 227, 255, 0.94); border-right-color: rgba(156, 227, 255, 0.94); border-top-color: rgba(156, 227, 255, 0.94); border-bottom-color: rgba(156, 227, 255, 0.94); border-radius: 26px; padding-left: 36px; padding-right: 36px; padding-top: 36px; padding-bottom: 36px; align-items: center; justify-content: center;">
            <ui:Label name="HeartDepletedTitle" text="하트가 모두 소진됐어요" style="font-size: 58px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-align: middle-center; margin-bottom: 14px; letter-spacing: 0.8px;"/>
            <ui:Label name="HeartDepletedMessage" text="광고를 시청하면 하트 3개가 즉시 충전되고 현재 스테이지가 다시 시작됩니다." style="font-size: 34px; color: rgba(210, 236, 255, 1); -unity-text-align: middle-center; margin-bottom: 18px;"/>
            <ui:Label name="HeartRefillRewardHint" text="보상: 하트 3개 + 즉시 재시작" style="font-size: 30px; color: rgba(161, 231, 255, 1); -unity-text-align: middle-center; margin-bottom: 26px;"/>
            <ui:Button name="HeartRefillAdButton" text="광고 보고 하트 3개 충전" style="width: 92%; max-width: 790px; height: 126px; font-size: 40px; color: rgb(255, 255, 255); border-radius: 22px; background-color: rgba(74, 193, 255, 0.26); border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px; border-left-color: rgba(189, 239, 255, 0.95); border-right-color: rgba(189, 239, 255, 0.95); border-top-color: rgba(189, 239, 255, 0.95); border-bottom-color: rgba(189, 239, 255, 0.95);"/>
