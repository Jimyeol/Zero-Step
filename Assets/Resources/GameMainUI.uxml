<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="TopBar" style="flex-direction: row; align-items: center; justify-content: space-between; width: 100%; height: auto; min-height: 130px; background-color: rgba(0, 0, 0, 0); padding-left: 50px; padding-right: 50px; padding-top: 130px; padding-bottom: 32px;">
        <ui:VisualElement name="StageContainer" style="flex-direction: column; align-items: center; padding-left: 8px; padding-right: 24px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Orbitron-Medium.ttf?fileID=12800000&amp;guid=d788a3059e71747c680a1ce1e963cd99&amp;type=3#Orbitron-Medium&quot;); -unity-font-style: bold;">
            <ui:Label name="StageTitle" text="STAGE" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Orbitron-Medium.ttf?fileID=12800000&amp;guid=d788a3059e71747c680a1ce1e963cd99&amp;type=3#Orbitron-Medium&quot;); font-size: 44px; color: rgb(255, 255, 255); -unity-font-style: bold; letter-spacing: 1px;"/>
            <ui:Label name="StageNumber" text="01" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Orbitron-Medium.ttf?fileID=12800000&amp;guid=d788a3059e71747c680a1ce1e963cd99&amp;type=3#Orbitron-Medium&quot;); font-size: 36px; color: rgb(255, 255, 255); -unity-font-style: bold; margin-top: 8px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="CenterContainer" style="flex-grow: 1; flex-direction: row; justify-content: center; padding-left: 60px; padding-right: 60px;">
            <ui:ProgressBar name="GameProgress" value="0" title="" style="width: 460px; height: 44px; color: rgb(255, 255, 255); font-size: 22px;"/>
        </ui:VisualElement>
        <ui:Button name="SettingButton" text="" style="width: 110px; height: 110px; background-color: rgba(0, 0, 0, 0); border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-left-width: 4px; border-right-width: 4px; border-top-width: 4px; border-bottom-width: 4px; border-radius: 999px; justify-content: center; align-items: center; padding-left: 8px; padding-right: 8px; padding-top: 8px; padding-bottom: 8px;">
            <ui:Image name="SettingIcon" style="width: 50px; height: 50px;"/>
        </ui:Button>
    </ui:VisualElement>
    <ui:VisualElement name="BottomBar" style="position: absolute; bottom: 80px; left: 0; right: 0; flex-direction: row; justify-content: space-around; align-items: center; padding-left: 80px; padding-right: 80px; background-color: rgba(0, 0, 0, 0); margin-bottom: 40px;">
        <ui:Button name="SkipButton" text="" style="width: 160px; height: 160px; background-color: rgba(0, 0, 0, 0); border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-left-width: 6px; border-right-width: 6px; border-top-width: 6px; border-bottom-width: 6px; border-radius: 999px; justify-content: center; align-items: center; padding-left: 8px; padding-right: 8px; padding-top: 8px; padding-bottom: 8px;">
            <ui:Image name="SkipIcon" style="width: 100px; height: 100px; align-items: center; justify-content: center; align-self: center; align-content: auto;"/>
            <ui:VisualElement name="SkipAdBadge" style="position: absolute; right: 4px; top: 4px; width: 46px; height: 46px; border-radius: 999px; background-color: rgb(255, 153, 153); justify-content: center; align-items: center;">
                <ui:Label name="SkipAdBadgeText" text="AD" style="-unity-font-style: bold; font-size: 17px; color: rgb(255, 255, 255); -unity-text-align: middle-center; letter-spacing: 0.5px;"/>
            </ui:VisualElement>
        </ui:Button>
        <ui:Button name="ResetButton" text="" style="width: 160px; height: 160px; background-color: rgba(0, 0, 0, 0); border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-left-width: 6px; border-right-width: 6px; border-top-width: 6px; border-bottom-width: 6px; border-radius: 999px; justify-content: center; align-items: center; padding-left: 8px; padding-right: 8px; padding-top: 8px; padding-bottom: 8px;">
            <ui:Image name="ResetIcon" style="width: 100px; height: 100px; justify-content: center; align-self: center; align-items: center; align-content: auto;"/>
        </ui:Button>
        <ui:Button name="BlockAdsButton" text="" style="width: 160px; height: 160px; background-color: rgba(0, 0, 0, 0); border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-left-width: 6px; border-right-width: 6px; border-top-width: 6px; border-bottom-width: 6px; border-radius: 999px; justify-content: center; align-items: center; padding-left: 8px; padding-right: 8px; padding-top: 8px; padding-bottom: 8px;">
            <ui:Image name="BlockIcon" style="width: 100px; height: 100px; align-items: center; justify-content: center; align-self: center; align-content: auto;"/>
        </ui:Button>
    </ui:VisualElement>
    <ui:VisualElement name="BannerAdContainer" style="position: absolute; bottom: 0; left: 0; right: 0; height: 80px; background-color: rgba(0, 0, 0, 0.3); justify-content: center; align-items: center;">
        <ui:Label name="BannerAdPlaceholder" text="Banner" style="font-size: 14px; color: rgba(255, 255, 255, 0.5); -unity-text-align: middle-center;"/>
    </ui:VisualElement>
    <ui:VisualElement name="SettingPopupOverlay" picking-mode="Position" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: none; justify-content: center; align-items: center; background-color: rgba(0, 0, 0, 0.65);">
        <ui:VisualElement name="SettingPopupPanel" style="width: 640px; max-width: 92%; height: 78%; max-height: 980px; min-height: 560px; background-color: rgba(8, 10, 16, 0.96); border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-radius: 20px; padding-left: 20px; padding-right: 20px; padding-top: 18px; padding-bottom: 18px;">
            <ui:VisualElement name="SettingHeader" style="height: 72px; flex-direction: row; justify-content: space-between; align-items: center; padding-left: 8px; padding-right: 8px;">
                <ui:Label name="SettingTitleLabel" text="설정" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Orbitron-Medium.ttf?fileID=12800000&amp;guid=d788a3059e71747c680a1ce1e963cd99&amp;type=3#Orbitron-Medium&quot;); font-size: 34px; color: rgb(255, 255, 255); -unity-font-style: bold; letter-spacing: 0.8px;"/>
                <ui:Button name="SettingCloseButton" text="닫기" style="width: 130px; height: 52px; font-size: 22px; color: rgb(255, 255, 255); background-color: rgba(255, 255, 255, 0.06); border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-radius: 999px;"/>
            </ui:VisualElement>

            <ui:ScrollView name="SettingScrollView" style="flex-grow: 1; margin-top: 6px;">
                <ui:Label text="게임 설정" style="font-size: 19px; color: rgba(143, 235, 255, 1); -unity-font-style: bold; margin-top: 8px; margin-left: 4px; margin-bottom: 10px;"/>

                <ui:VisualElement name="SoundRow" style="height: 78px; flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 10px; padding-left: 14px; padding-right: 14px; border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(255, 255, 255, 0.35); border-right-color: rgba(255, 255, 255, 0.35); border-top-color: rgba(255, 255, 255, 0.35); border-bottom-color: rgba(255, 255, 255, 0.35); border-radius: 14px; background-color: rgba(255, 255, 255, 0.03);">
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Image name="SoundIcon" class="settings-icon" style="margin-right: 12px;"/>
                        <ui:Label text="소리" style="font-size: 24px; color: rgb(255, 255, 255);"/>
                    </ui:VisualElement>
                    <ui:Button name="SoundSwitchButton" class="settings-switch settings-switch-on" text="">
                        <ui:Label name="SoundSwitchLabel" text="ON" class="settings-switch-label"/>
                        <ui:VisualElement name="SoundSwitchKnob" class="settings-switch-knob"/>
                    </ui:Button>
                </ui:VisualElement>

                <ui:VisualElement name="VibrationRow" style="height: 78px; flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 18px; padding-left: 14px; padding-right: 14px; border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(255, 255, 255, 0.35); border-right-color: rgba(255, 255, 255, 0.35); border-top-color: rgba(255, 255, 255, 0.35); border-bottom-color: rgba(255, 255, 255, 0.35); border-radius: 14px; background-color: rgba(255, 255, 255, 0.03);">
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Image name="VibrationIcon" class="settings-icon" style="margin-right: 12px;"/>
                        <ui:Label text="진동" style="font-size: 24px; color: rgb(255, 255, 255);"/>
                    </ui:VisualElement>
                    <ui:Button name="VibrationSwitchButton" class="settings-switch settings-switch-on" text="">
                        <ui:Label name="VibrationSwitchLabel" text="ON" class="settings-switch-label"/>
                        <ui:VisualElement name="VibrationSwitchKnob" class="settings-switch-knob"/>
                    </ui:Button>
                </ui:VisualElement>

                <ui:Label text="도움말 · 언어" style="font-size: 19px; color: rgba(143, 235, 255, 1); -unity-font-style: bold; margin-left: 4px; margin-bottom: 10px;"/>

                <ui:Button name="HelpButton" text="" style="height: 72px; margin-bottom: 10px; border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(255, 255, 255, 0.35); border-right-color: rgba(255, 255, 255, 0.35); border-top-color: rgba(255, 255, 255, 0.35); border-bottom-color: rgba(255, 255, 255, 0.35); border-radius: 14px; background-color: rgba(255, 255, 255, 0.03); justify-content: center;">
                    <ui:VisualElement style="flex-direction: row; align-items: center; padding-left: 14px;">
                        <ui:Image name="HelpIcon" class="settings-icon" style="margin-right: 12px;"/>
                        <ui:Label text="도움말" style="font-size: 23px; color: rgb(255, 255, 255);"/>
                    </ui:VisualElement>
                </ui:Button>

                <ui:Button name="LanguageButton" text="" style="height: 72px; margin-bottom: 18px; border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(255, 255, 255, 0.35); border-right-color: rgba(255, 255, 255, 0.35); border-top-color: rgba(255, 255, 255, 0.35); border-bottom-color: rgba(255, 255, 255, 0.35); border-radius: 14px; background-color: rgba(255, 255, 255, 0.03); justify-content: center;">
                    <ui:VisualElement style="flex-direction: row; align-items: center; padding-left: 14px;">
                        <ui:Image name="LanguageIcon" class="settings-icon" style="margin-right: 12px;"/>
                        <ui:Label text="언어 변경" style="font-size: 23px; color: rgb(255, 255, 255);"/>
                    </ui:VisualElement>
                </ui:Button>

                <ui:Label text="추천 · 서비스" style="font-size: 19px; color: rgba(143, 235, 255, 1); -unity-font-style: bold; margin-left: 4px; margin-bottom: 10px;"/>
                <ui:Button name="RateButton" text="평가하기" style="height: 68px; margin-bottom: 10px; font-size: 22px; color: rgb(255, 255, 255); border-radius: 14px; background-color: rgba(255, 255, 255, 0.03); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(255, 255, 255, 0.35); border-right-color: rgba(255, 255, 255, 0.35); border-top-color: rgba(255, 255, 255, 0.35); border-bottom-color: rgba(255, 255, 255, 0.35);"/>
                <ui:Button name="RemoveAdsButton" text="광고 제거" style="height: 68px; margin-bottom: 10px; font-size: 22px; color: rgb(255, 255, 255); border-radius: 14px; background-color: rgba(255, 209, 102, 0.14); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(255, 255, 255, 0.45); border-right-color: rgba(255, 255, 255, 0.45); border-top-color: rgba(255, 255, 255, 0.45); border-bottom-color: rgba(255, 255, 255, 0.45);"/>
                <ui:Button name="EmailButton" text="개발자에게 이메일 보내기" style="height: 68px; margin-bottom: 18px; font-size: 22px; color: rgb(255, 255, 255); border-radius: 14px; background-color: rgba(255, 255, 255, 0.03); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(255, 255, 255, 0.35); border-right-color: rgba(255, 255, 255, 0.35); border-top-color: rgba(255, 255, 255, 0.35); border-bottom-color: rgba(255, 255, 255, 0.35);"/>

                <ui:Label text="데이터 · 정책" style="font-size: 19px; color: rgba(255, 181, 181, 1); -unity-font-style: bold; margin-left: 4px; margin-bottom: 10px;"/>
                <ui:Button name="ResetDataButton" text="데이터 초기화" style="height: 68px; margin-bottom: 10px; font-size: 22px; color: rgb(255, 255, 255); border-radius: 14px; background-color: rgba(255, 109, 109, 0.18); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(255, 140, 140, 0.7); border-right-color: rgba(255, 140, 140, 0.7); border-top-color: rgba(255, 140, 140, 0.7); border-bottom-color: rgba(255, 140, 140, 0.7);"/>
                <ui:Button name="PrivacyPolicyButton" text="개인정보처리방침" style="height: 64px; margin-bottom: 10px; font-size: 20px; color: rgba(234, 238, 255, 1); border-radius: 14px; background-color: rgba(255, 255, 255, 0.02); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(255, 255, 255, 0.28); border-right-color: rgba(255, 255, 255, 0.28); border-top-color: rgba(255, 255, 255, 0.28); border-bottom-color: rgba(255, 255, 255, 0.28);"/>
                <ui:Button name="TermsButton" text="이용약관" style="height: 64px; margin-bottom: 10px; font-size: 20px; color: rgba(234, 238, 255, 1); border-radius: 14px; background-color: rgba(255, 255, 255, 0.02); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(255, 255, 255, 0.28); border-right-color: rgba(255, 255, 255, 0.28); border-top-color: rgba(255, 255, 255, 0.28); border-bottom-color: rgba(255, 255, 255, 0.28);"/>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
