    border-top-width: 4px;
    border-bottom-width: 4px;
    border-left-color: rgba(255, 104, 122, 0.96);
    border-right-color: rgba(255, 104, 122, 0.96);
    border-top-color: rgba(255, 104, 122, 0.96);
    border-bottom-color: rgba(255, 104, 122, 0.96);
    background-color: rgba(96, 12, 24, 0.66);
    opacity: 0;
    justify-content: center;
    align-items: center;
    transition-property: opacity, scale;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.tutorial-short-circuit-blocked-entry-label {
    color: rgba(255, 232, 236, 1);
    font-size: 48px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.tutorial-grid-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.tutorial-demo-grid-tile {
    width: 136px;
    height: 136px;
    margin-left: 12px;
    margin-right: 12px;
    margin-top: 12px;
    margin-bottom: 12px;
}

.tutorial-demo-short-circuit {
    position: relative;
    background-color: rgba(255, 184, 89, 0.26);
    border-left-color: rgba(255, 225, 162, 0.95);
    border-right-color: rgba(255, 225, 162, 0.95);
    border-top-color: rgba(255, 225, 162, 0.95);
    border-bottom-color: rgba(255, 225, 162, 0.95);
}

.tutorial-short-circuit-tile-image {
    position: absolute;
    left: 8%;
    top: 8%;
    width: 84%;
    height: 84%;
    opacity: 0.96;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale, opacity;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.tutorial-special-board {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    position: relative;
}

.tutorial-special-effect-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.tutorial-special-grid {
    width: 342px;
    height: 342px;
    justify-content: center;
    align-items: center;
}

.tutorial-special-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.tutorial-special-cell {
    position: relative;
    width: 96px;
    height: 96px;
    margin-left: 7px;
    margin-right: 7px;
    margin-top: 7px;
    margin-bottom: 7px;
    border-radius: 14px;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgba(153, 230, 255, 0.88);
    border-right-color: rgba(153, 230, 255, 0.88);
    border-top-color: rgba(153, 230, 255, 0.88);
    border-bottom-color: rgba(153, 230, 255, 0.88);
    background-color: rgba(10, 30, 44, 0.78);
    justify-content: center;
    align-items: center;
    transition-property: opacity, scale, background-color, border-left-color, border-right-color, border-top-color, border-bottom-color;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.tutorial-special-sprite {
    position: absolute;
    left: 10%;
    top: 10%;
    width: 80%;
    height: 80%;
    opacity: 0;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: opacity, scale;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.tutorial-special-count {
    position: absolute;
    left: 0;
