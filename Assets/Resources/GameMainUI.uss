}

.tutorial-special-trail,
.tutorial-special-beam,
.tutorial-special-pair-line {
    position: absolute;
    border-radius: 7px;
    opacity: 0;
    background-color: rgba(116, 225, 255, 0.24);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
