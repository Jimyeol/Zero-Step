    font-size: 48px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.tutorial-special-hand {
    position: absolute;
    width: 88px;
    height: 88px;
    opacity: 0;
    transition-property: left, top, scale, opacity;
    transition-duration: 0.26s;
    transition-timing-function: ease-out;
}

.tutorial-special-cell-cross {
    border-left-color: rgba(91, 244, 255, 0.96);
    border-right-color: rgba(91, 244, 255, 0.96);
    border-top-color: rgba(91, 244, 255, 0.96);
    border-bottom-color: rgba(91, 244, 255, 0.96);
    background-color: rgba(14, 74, 86, 0.82);
}

.tutorial-special-cell-fixed {
    border-left-color: rgba(255, 122, 122, 0.96);
    border-right-color: rgba(255, 122, 122, 0.96);
    border-top-color: rgba(255, 122, 122, 0.96);
    border-bottom-color: rgba(255, 122, 122, 0.96);
    background-color: rgba(82, 24, 30, 0.82);
}

.tutorial-special-cell-twin {
    border-left-color: rgba(184, 132, 255, 0.98);
    border-right-color: rgba(184, 132, 255, 0.98);
    border-top-color: rgba(184, 132, 255, 0.98);
    border-bottom-color: rgba(184, 132, 255, 0.98);
    background-color: rgba(54, 32, 88, 0.84);
}

.tutorial-special-cell-igniter {
    border-left-color: rgba(255, 186, 88, 0.98);
    border-right-color: rgba(255, 186, 88, 0.98);
    border-top-color: rgba(255, 186, 88, 0.98);
    border-bottom-color: rgba(255, 186, 88, 0.98);
    background-color: rgba(84, 46, 15, 0.84);
}

.tutorial-special-cell-blind,
.tutorial-special-cell-blackout {
    border-left-color: rgba(185, 210, 232, 0.92);
    border-right-color: rgba(185, 210, 232, 0.92);
    border-top-color: rgba(185, 210, 232, 0.92);
    border-bottom-color: rgba(185, 210, 232, 0.92);
    background-color: rgba(18, 23, 32, 0.88);
}

.tutorial-special-cell-hidden {
    opacity: 0.2;
    border-left-color: rgba(93, 117, 136, 0.28);
    border-right-color: rgba(93, 117, 136, 0.28);
    border-top-color: rgba(93, 117, 136, 0.28);
    border-bottom-color: rgba(93, 117, 136, 0.28);
    background-color: rgba(4, 8, 12, 0.2);
}

.tutorial-demo-arrow {
    position: absolute;
    top: 8px;
    right: 16px;
    color: rgba(255, 244, 212, 0.98);
    font-size: 42px;
    -unity-font-style: bold;
}
