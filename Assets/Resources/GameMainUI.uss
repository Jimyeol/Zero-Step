    border-right-color: rgba(221, 251, 255, 0.96);
    border-top-color: rgba(221, 251, 255, 0.96);
    border-bottom-color: rgba(221, 251, 255, 0.96);
}

.tutorial-nav-label {
    color: rgba(229, 252, 255, 1);
    font-size: 62px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

#TutorialHandImage {
    transition-property: left, top, scale, opacity;
    transition-duration: 0.26s;
    transition-timing-function: ease-out;
}

.tutorial-basic-path-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.tutorial-basic-trail {
    position: absolute;
    height: 14px;
    border-radius: 7px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(157, 241, 255, 0.52);
