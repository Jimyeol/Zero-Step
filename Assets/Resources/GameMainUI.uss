    height: 100%;
    color: rgba(219, 252, 255, 0.34);
    font-size: 50px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(198, 250, 255, 0.95);
}

.tutorial-special-badge {
    position: absolute;
    right: 6px;
    top: 4px;
    min-width: 28px;
    height: 28px;
