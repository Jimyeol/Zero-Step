/* ProgressBar fill must exactly match background height with no bottom gap. */
#GameProgress {
    margin: 0;
    padding: 0;
    overflow: hidden;
}

#GameProgress > .unity-progress-bar__container,
#GameProgress > .unity-progress-bar__background {
    margin: 0;
    padding: 0;
    position: relative;
    height: 100%;
    min-height: 100%;
    max-height: 100%;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: stretch;
}

#GameProgress .unity-progress-bar__progress {
    margin: 0;
    padding: 0;
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    height: 100%;
    min-height: 100%;
    max-height: 100%;
    align-self: stretch;
}

#GameProgress .unity-progress-bar__progress > * {
    margin: 0;
    padding: 0;
    top: 0;
    bottom: 0;
    height: 100%;
    min-height: 100%;
    max-height: 100%;
}

/* Top HUD neon cyber frame */
.top-hud {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 204px;
    padding-left: 42px;
    padding-right: 42px;
    padding-top: 64px;
    padding-bottom: 20px;
    background-color: rgba(0, 0, 0, 0);
    position: relative;
    overflow: visible;
    -unity-font-definition: url("project://database/Assets/Fonts/Orbitron-Medium.ttf?fileID=12800000&guid=d788a3059e71747c680a1ce1e963cd99&type=3#Orbitron-Medium");
    -unity-font-style: bold;
}

.top-hud-backdrop {
    position: absolute;
    left: 22px;
    right: 22px;
    top: 26px;
    bottom: 8px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(0, 180, 255, 0.18);
    border-right-color: rgba(0, 180, 255, 0.18);
    border-top-color: rgba(0, 180, 255, 0.1);
    border-bottom-color: rgba(0, 180, 255, 0.1);
    border-radius: 18px;
    background-color: rgba(1, 8, 17, 0.2);
}

.top-hud-circuit-line {
    position: absolute;
    height: 2px;
    border-radius: 2px;
    background-color: rgba(0, 205, 255, 0.24);
}

.top-hud-circuit-line-a {
    left: 8%;
    top: 34px;
    width: 18%;
}

.top-hud-circuit-line-b {
    left: 42%;
    top: 26px;
    width: 24%;
}

.top-hud-circuit-line-c {
    right: 8%;
    bottom: 28px;
    width: 20%;
}

.top-hud-circuit-dot {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(0, 224, 255, 0.55);
    border-right-color: rgba(0, 224, 255, 0.55);
    border-top-color: rgba(0, 224, 255, 0.55);
    border-bottom-color: rgba(0, 224, 255, 0.55);
    background-color: rgba(0, 224, 255, 0.12);
}

.top-hud-circuit-dot-a {
    left: 5%;
    bottom: 36px;
}

.top-hud-circuit-dot-b {
    right: 17%;
    top: 38px;
}

.top-hud-circuit-dot-c {
    right: 6%;
    top: 68px;
}

.top-hud-corner {
    position: absolute;
    width: 64px;
    height: 64px;
    background-color: rgba(0, 0, 0, 0);
}

.top-hud-corner-left {
    left: 18px;
    bottom: 18px;
    border-left-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgba(0, 207, 255, 0.5);
    border-bottom-color: rgba(0, 207, 255, 0.5);
}

.top-hud-corner-right {
    right: 18px;
    top: 18px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-right-color: rgba(0, 207, 255, 0.5);
    border-top-color: rgba(0, 207, 255, 0.5);
}

.top-stage-panel {
    width: 176px;
    min-width: 160px;
    min-height: 112px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 12px;
    padding-bottom: 12px;
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 2px;
    border-left-color: rgba(0, 205, 255, 0.4);
    border-right-color: rgba(0, 120, 210, 0.18);
    border-top-color: rgba(0, 205, 255, 0.16);
    border-bottom-color: rgba(0, 205, 255, 0.28);
    border-radius: 8px;
