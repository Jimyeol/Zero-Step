/* ProgressBar fill must exactly match background height with no bottom gap. */
#GameProgress {
    margin: 0;
    padding: 0;
    overflow: hidden;
}

#GameProgress > .unity-progress-bar__container,
#GameProgress > .unity-progress-bar__background {
    margin: 0;
    padding: 0;
    position: relative;
    height: 100%;
    min-height: 100%;
    max-height: 100%;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: stretch;
}

#GameProgress .unity-progress-bar__progress {
    margin: 0;
    padding: 0;
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    height: 100%;
    min-height: 100%;
    max-height: 100%;
    align-self: stretch;
}

#GameProgress .unity-progress-bar__progress > * {
    margin: 0;
    padding: 0;
    top: 0;
    bottom: 0;
    height: 100%;
    min-height: 100%;
    max-height: 100%;
}

/* Settings Popup Visual Language */
#SettingPopupPanel {
    -unity-font-definition: url("project://database/Assets/Fonts/Orbitron-Medium.ttf?fileID=12800000&guid=d788a3059e71747c680a1ce1e963cd99&type=3#Orbitron-Medium");
    font-size: 28px;
}

#SettingScrollView {
    padding-left: 2px;
    padding-right: 2px;
}

#SettingScrollView .unity-scroller--vertical {
    width: 0;
    min-width: 0;
    max-width: 0;
    opacity: 0;
}

#SettingScrollView .unity-scroll-view__content-and-vertical-scroll-container {
    padding-right: 0;
    margin-right: 0;
}

#SettingPopupPanel Button {
    transition-property: background-color, border-left-color, border-right-color, border-top-color, border-bottom-color;
    transition-duration: 0.12s;
}

#SettingPopupPanel Button:hover {
    background-color: rgba(120, 220, 255, 0.12);
    border-left-color: rgba(180, 244, 255, 0.9);
    border-right-color: rgba(180, 244, 255, 0.9);
    border-top-color: rgba(180, 244, 255, 0.9);
    border-bottom-color: rgba(180, 244, 255, 0.9);
}

#SettingCloseButton {
    min-width: 108px;
    min-height: 108px;
    background-color: rgba(0, 0, 0, 0) !important;
    border-left-width: 0 !important;
    border-right-width: 0 !important;
    border-top-width: 0 !important;
    border-bottom-width: 0 !important;
    border-radius: 0 !important;
}

#SettingCloseButton:hover {
    background-color: rgba(0, 0, 0, 0) !important;
    border-left-width: 0 !important;
    border-right-width: 0 !important;
    border-top-width: 0 !important;
    border-bottom-width: 0 !important;
}

.neon-press-button {
    transition-property: background-color, border-left-color, border-right-color, border-top-color, border-bottom-color, opacity;
    transition-duration: 0.09s;
    transition-timing-function: ease-out;
}

.neon-press-button.neon-press-active {
    background-color: rgba(74, 240, 255, 0.18);
    border-left-color: rgba(177, 248, 255, 0.98);
    border-right-color: rgba(177, 248, 255, 0.98);
    border-top-color: rgba(177, 248, 255, 0.98);
    border-bottom-color: rgba(177, 248, 255, 0.98);
    opacity: 0.96;
}

.neon-press-button.neon-press-button-warm.neon-press-active {
    background-color: rgba(255, 196, 82, 0.22);
    border-left-color: rgba(255, 234, 170, 0.98);
    border-right-color: rgba(255, 234, 170, 0.98);
    border-top-color: rgba(255, 234, 170, 0.98);
    border-bottom-color: rgba(255, 234, 170, 0.98);
}

.settings-icon {
    width: 80px;
    height: 80px;
    -unity-background-scale-mode: scale-to-fit;
    overflow: visible;
    flex-shrink: 0;
}

.settings-switch {
    width: 240px;
    height: 94px;
    border-radius: 24px;
    padding-left: 18px;
    padding-right: 18px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
}

.settings-switch-on {
    background-color: rgba(70, 236, 182, 0.24);
    border-left-color: rgba(129, 255, 215, 0.9);
    border-right-color: rgba(129, 255, 215, 0.9);
    border-top-color: rgba(129, 255, 215, 0.9);
    border-bottom-color: rgba(129, 255, 215, 0.9);
}

.settings-switch-off {
    background-color: rgba(255, 128, 128, 0.2);
    border-left-color: rgba(255, 166, 166, 0.85);
    border-right-color: rgba(255, 166, 166, 0.85);
    border-top-color: rgba(255, 166, 166, 0.85);
    border-bottom-color: rgba(255, 166, 166, 0.85);
}

.settings-switch-label {
    font-size: 34px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-left: 4px;
    margin-right: 4px;
}

.settings-switch-knob {
    width: 46px;
    height: 46px;
    border-radius: 999px;
    background-color: rgb(255, 255, 255);
}

.settings-switch-on .settings-switch-knob {
    background-color: rgba(212, 255, 238, 1);
}

.settings-switch-off .settings-switch-knob {
    background-color: rgba(255, 234, 234, 1);
}

#HeartContainer > Image {
    -unity-background-scale-mode: scale-to-fit;
    overflow: visible;
}

.heart-icon {
    transition-property: opacity, scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

#HeartDepletedDialog {
    transition-property: opacity, scale;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

#HeartRefillAdButton {
    transition-property: background-color, border-left-color, border-right-color, border-top-color, border-bottom-color, opacity;
    transition-duration: 0.12s;
}

#HeartRefillAdButton:hover {
    background-color: rgba(91, 196, 255, 0.38);
    border-left-color: rgba(214, 241, 255, 0.95);
    border-right-color: rgba(214, 241, 255, 0.95);
    border-top-color: rgba(214, 241, 255, 0.95);
    border-bottom-color: rgba(214, 241, 255, 0.95);
}

#HeartRefillAdButton:active {
    background-color: rgba(130, 214, 255, 0.46);
}

#StageSnackbar {
    transition-property: opacity, scale;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

#StageSnackbarLabel {
    width: 100%;
    max-width: 100%;
    white-space: normal;
    flex-shrink: 1;
}

#ResetConfirmMessage,
#HeartDepletedMessage,
#HeartRefillRewardHint,
#HeartRefillStatusLabel,
#StageSnackbarLabel,
#TutorialDescriptionLabel,
#TutorialStepHintLabel {
    width: 100%;
    max-width: 100%;
    white-space: normal;
    flex-shrink: 1;
}

#TutorialTitleLabel {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 14px;
    white-space: normal;
}

#TutorialDialog {
    transition-property: opacity, scale;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

#TutorialCloseButton {
    min-width: 96px;
    min-height: 96px;
    background-color: rgba(0, 0, 0, 0) !important;
    border-left-width: 0 !important;
    border-right-width: 0 !important;
    border-top-width: 0 !important;
    border-bottom-width: 0 !important;
    border-radius: 0 !important;
}

#TutorialCloseButton:hover {
    background-color: rgba(0, 0, 0, 0) !important;
    border-left-width: 0 !important;
    border-right-width: 0 !important;
    border-top-width: 0 !important;
    border-bottom-width: 0 !important;
}

#TutorialHandImage {
    transition-property: left, top, scale, opacity;
    transition-duration: 0.26s;
    transition-timing-function: ease-out;
}

#LanguageSelectDialog {
    transition-property: opacity, scale;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

#LanguageSelectCloseButton {
    min-width: 96px;
    min-height: 96px;
    background-color: rgba(0, 0, 0, 0) !important;
    border-left-width: 0 !important;
    border-right-width: 0 !important;
    border-top-width: 0 !important;
    border-bottom-width: 0 !important;
    border-radius: 0 !important;
}

#LanguageSelectCloseButton:hover {
    background-color: rgba(0, 0, 0, 0) !important;
    border-left-width: 0 !important;
    border-right-width: 0 !important;
    border-top-width: 0 !important;
    border-bottom-width: 0 !important;
}

#LanguageSelectScrollView .unity-scroller--vertical {
    width: 0;
    min-width: 0;
    max-width: 0;
    opacity: 0;
}

#LanguageOptionList {
    padding-bottom: 10px;
}

.language-option-button {
    height: 100px;
    margin-bottom: 12px;
    font-size: 34px;
    color: rgba(240, 248, 255, 1);
    border-radius: 18px;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgba(170, 208, 228, 0.52);
    border-right-color: rgba(170, 208, 228, 0.52);
    border-top-color: rgba(170, 208, 228, 0.52);
    border-bottom-color: rgba(170, 208, 228, 0.52);
    background-color: rgba(255, 255, 255, 0.04);
}

.language-option-button:hover {
    background-color: rgba(84, 184, 240, 0.2);
    border-left-color: rgba(178, 234, 255, 0.92);
    border-right-color: rgba(178, 234, 255, 0.92);
    border-top-color: rgba(178, 234, 255, 0.92);
    border-bottom-color: rgba(178, 234, 255, 0.92);
}

.language-option-selected {
    background-color: rgba(79, 203, 255, 0.24);
    border-left-color: rgba(197, 241, 255, 0.95);
    border-right-color: rgba(197, 241, 255, 0.95);
    border-top-color: rgba(197, 241, 255, 0.95);
    border-bottom-color: rgba(197, 241, 255, 0.95);
}

.tutorial-demo-tile {
    width: 148px;
    height: 148px;
    margin-left: 18px;
    margin-right: 18px;
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-left-color: rgba(187, 239, 255, 0.92);
    border-right-color: rgba(187, 239, 255, 0.92);
    border-top-color: rgba(187, 239, 255, 0.92);
    border-bottom-color: rgba(187, 239, 255, 0.92);
    border-radius: 22px;
    background-color: rgba(61, 191, 255, 0.19);
    justify-content: center;
    align-items: center;
    transition-property: opacity, scale, background-color, border-left-color, border-right-color, border-top-color, border-bottom-color;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.tutorial-demo-count {
    color: rgb(255, 255, 255);
    font-size: 64px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.tutorial-grid-demo-wrap {
    width: 356px;
    height: 320px;
    justify-content: center;
    align-items: center;
}

.tutorial-grid-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.tutorial-demo-grid-tile {
    width: 136px;
    height: 136px;
    margin-left: 12px;
    margin-right: 12px;
    margin-top: 12px;
    margin-bottom: 12px;
}

.tutorial-demo-short-circuit {
    position: relative;
    background-color: rgba(255, 184, 89, 0.26);
    border-left-color: rgba(255, 225, 162, 0.95);
    border-right-color: rgba(255, 225, 162, 0.95);
    border-top-color: rgba(255, 225, 162, 0.95);
    border-bottom-color: rgba(255, 225, 162, 0.95);
}

.tutorial-demo-arrow {
    position: absolute;
    top: 8px;
    right: 16px;
    color: rgba(255, 244, 212, 0.98);
    font-size: 42px;
    -unity-font-style: bold;
}
