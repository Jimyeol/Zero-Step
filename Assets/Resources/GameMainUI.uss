.tutorial-special-pulse,
.tutorial-special-reveal-pulse {
    position: absolute;
    width: 72px;
    height: 72px;
    border-radius: 36px;
    opacity: 0;
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-left-color: rgba(255, 238, 168, 0.92);
    border-right-color: rgba(255, 238, 168, 0.92);
    border-top-color: rgba(255, 238, 168, 0.92);
    border-bottom-color: rgba(255, 238, 168, 0.92);
    background-color: rgba(255, 202, 82, 0.14);
    transition-property: opacity, scale;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.tutorial-special-blocked-marker {
    position: absolute;
    width: 58px;
    height: 58px;
    border-radius: 29px;
    opacity: 0;
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-left-color: rgba(255, 96, 116, 0.96);
    border-right-color: rgba(255, 96, 116, 0.96);
    border-top-color: rgba(255, 96, 116, 0.96);
    border-bottom-color: rgba(255, 96, 116, 0.96);
